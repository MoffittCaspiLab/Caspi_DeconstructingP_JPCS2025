144      if DOB ne . then age_start = YRDIF(DOB, MDY(01,01,2006), 'AGE');
145      if DOB ne . then age_end   = YRDIF(DOB, MDY(12,31,2024), 'AGE');
146      if DOB ne . and DOD ne . then age_death = YRDIF(DOB, DOD, 'AGE');
